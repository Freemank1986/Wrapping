# Copy this file to .env and fill in the values you need.

# Required. A Postgres connection string. For Vercel: Vercel Postgres, Neon,
# and Supabase all work — use the "pooled"/"pgbouncer" connection string if
# your provider distinguishes one, since serverless functions open many
# short-lived connections.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Required. Generate with: openssl rand -base64 32
SESSION_SECRET=""

# Optional — payments are disabled gracefully in the UI until these are set.
# Get test keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional — used only by `npx prisma db seed`. Defaults shown below.
# SEED_ADMIN_EMAIL="admin@wrapt.local"
# SEED_ADMIN_PASSWORD="AdminWrap123!"
